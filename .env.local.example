# Supabase — get these from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DeepSeek API — get from platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key

# Buffer API — get from buffer.com/developers
BUFFER_CLIENT_ID=your-buffer-client-id
BUFFER_CLIENT_SECRET=your-buffer-client-secret
BUFFER_REDIRECT_URI=http://localhost:3000/api/buffer/callback

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
